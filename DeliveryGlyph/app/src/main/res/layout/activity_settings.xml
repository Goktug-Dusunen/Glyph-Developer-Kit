<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Uygulamalar ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uygulamalar"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <!-- Built-in switch'ler buraya programmatik eklenir -->
        <LinearLayout
            android:id="@+id/llAppSwitches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8F8F8"
            android:padding="8dp" />

        <!-- ── Özel Uygulamalar ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Özel Uygulamalar"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/llCustomApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8F8F8"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnAddApp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Uygulama Ekle" />

        <!-- ── Animasyon Hızı ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Animasyon Hızı"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgBlinkSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8F8F8"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/rbFast"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Hızlı (kurye kapıda!)" />

            <RadioButton
                android:id="@+id/rbNormal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Normal"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbSlow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Yavaş (sessiz ortam)" />
        </RadioGroup>

        <!-- ── Geçmiş ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diğer"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnClearHistory"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Geçmişi Temizle"
            android:textColor="#CC0000" />

        <View android:layout_width="match_parent" android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>
